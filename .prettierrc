{
  "plugins": [
    "prettier-plugin-astro",
    "prettier-plugin-tailwindcss"
  ],
  "printWidth": 40,
  "singleAttributePerLine": false,
  "useTabs": false,
  "tabWidth": 2,
  "overrides": [
    {
      "files": "*.astro",
      "options": {
        "parser": "astro",
        "printWidth": 40
      }
    }
  ]
}
