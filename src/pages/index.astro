---
import Layout from '../layouts/Layout.astro';
import Badge from '../components/Badge.astro';
---

<Layout title="Pazos-Dev">
   <main>
      <section class="w-full lg:w-185 mx-auto py-44">
      <h1 class="text-white text-5xl font-bold flex flex-row justify-center  gap-x-4 pb-10">
         Hi, I'm Luis Pazos! 
         <a href="">
            <Badge class=" flex justify-center items-center">Disponible para trabajar</Badge> 
         </a>
      </h1>
      <h2 class="text-xl opacity-80">Técnico Informático con +7 años de experiencia. Ahora, iniciándome como Desarrollador Web Junior.</h2>
      <p class="text-xs text-right  opacity-60 pl-50 py-3">Provengo del mundo del soporte técnico, la administración de sistemas y el mantenimiento informático. Esa es mi base. Ahora estoy enfocado en dar el salto al desarrollo web, buscando mi primera oportunidad como programador.</p>
      </section>
</main>
	
</Layout>
